# Exemplo de configuração de segredos
# Renomeie para secrets.toml dentro da pasta .streamlit/

[connections.gsheets]
spreadsheet = "URL_DA_SUA_PLANILHA_AQUI"
type = "service_account"
project_id = "seus_dados_aqui"
private_key_id = "seus_dados_aqui"
private_key = "seus_dados_aqui"
client_email = "seus_dados_aqui"
client_id = "seus_dados_aqui"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "seus_dados_aqui"
